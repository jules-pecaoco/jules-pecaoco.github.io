---
import { content } from '../data/content.js';
import Base from '../layouts/Base.astro';
---
<Base title="About Jules — Web & Mobile Developer" path="/about/"><section class="page-heading"><p class="eyebrow">THE PERSON BEHIND THE WORK</p><h1>I'm Jules.</h1></section><section class="split"><img class="portrait" src={content.site.profileImage} alt="Jules Alfonz Pecaoco" width="389" height="500"/><div><h2>{content.site.aboutHeading}</h2>{content.site.aboutBio.split(/\n\n/).map(paragraph=><p>{paragraph}</p>)}<div class="actions"><a class="button primary" href="/resume/">View my CV ↗</a><a class="button" href="/contact/">Start a conversation</a></div><motto>Sic Parvis Magna. A reminder to keep building, learning, and moving forward.</motto></div></section><section class="section"><p class="eyebrow">STARTING A PROJECT</p><h2>A useful conversation<br/>starts with the problem.</h2><div class="capabilities"><article><h3>01 · Understand</h3><p>Who will use it? What is difficult today? Share the workflow, constraints, and outcome you have in mind.</p></article><article><h3>02 · Define</h3><p>Discuss the features, data, interfaces, and integrations needed to make the solution useful.</p></article><article><h3>03 · Plan delivery</h3><p>Agree on priorities, review points, deployment needs, and handover expectations before starting.</p></article></div><div class="actions"><a class="button primary" href="/contact/">Tell me about your project ↗</a><a class="button" href="/resume/">Explore my background</a></div></section></Base>