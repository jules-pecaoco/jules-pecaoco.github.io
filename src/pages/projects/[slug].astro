---
import { projectImage, projects } from '../../data/content.js';
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}))}
const {project:p}=Astro.props;
const next=projects[(projects.findIndex(x=>x.slug===p.slug)+1)%projects.length];
---
<Base title={p.title+' — Jules Pecaoco'} description={p.summary} path={'/projects/'+p.slug+'/'}><section class="page-heading"><a href="/projects/">← All projects</a><p class="eyebrow">{p.category}</p><h1>{p.title}</h1><p>{p.summary}</p><div class="project-facts"><div><span>Focus</span><strong>{p.category}</strong></div><div><span>Technology</span><strong>{p.tools}</strong></div><div><span>Explore</span><strong>{p.live?'Website & source':'Source code'}</strong></div></div></section><nav class="case-nav" aria-label="Case study sections"><a href="#purpose">Purpose</a><a href="#implementation">Implementation</a><a href="#explore">Explore</a></nav><article class="story">{p.image&&<figure><a href={projectImage(p)} data-lightbox aria-label={'Enlarge '+p.title+' screenshot'}><img class="story-image" src={projectImage(p)} alt={p.title+' application interface'} width="1000" height="650"/></a><figcaption>{p.title} · Interface preview. Select to enlarge.</figcaption></figure>}<section id="purpose"><p class="eyebrow">01 / CONTEXT</p><h2>The purpose</h2><p>{p.problem}</p></section><section id="implementation"><p class="eyebrow">02 / THE WORK</p><h2>Inside the project</h2>{p.story.split(/\n\n/).map(text=><p>{text}</p>)}</section><section id="explore"><p class="eyebrow">03 / TAKE A CLOSER LOOK</p><h2>Explore the work</h2><p>Review the available application and implementation, then get in touch to discuss the project in more detail.</p><div class="actions">{p.live&&<a class="button primary" href={p.live} target="_blank" rel="noopener noreferrer">Open live project ↗</a>}{p.repo&&<a class="button" href={'https://github.com/jules-pecaoco/'+p.repo} target="_blank" rel="noopener noreferrer">View source ↗</a>}</div></section><aside class="note"><h3>Have a similar problem?</h3><p>Tell me about your users, the workflow you want to improve, and what a useful result would look like.</p><a href="/contact/">Discuss a project ↗</a></aside><div class="next-project"><p class="eyebrow">KEEP EXPLORING</p><a class="footer-title" href={'/projects/'+next.slug+'/'}>{next.title} →</a></div></article></Base>
