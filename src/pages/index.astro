---
import Base from '../layouts/Base.astro';import Card from '../components/ProjectCard.astro';import { projects, content } from '../data/content.js';
---
<Base><section class="hero"><span class="motif" aria-hidden="true">&lt;/&gt;</span><p class="eyebrow">{content.site.role}</p><h1>{content.site.greeting}<br/>{content.site.headline}</h1><p class="intro">{content.site.intro}</p><div class="actions"><a class="button primary" href="/projects/">Explore my work ↗</a><a class="button" href="/resume/">View my CV</a><a class="button" href="/contact/">Let’s talk</a></div><motto>{content.site.motto}</motto><a class="hero-device" href="/projects/tanaw/" aria-label="Explore TANAW mobile application"><span class="device-camera"></span><img src="/images/tanaw-640.webp" srcset="/images/tanaw-320.webp 320w, /images/tanaw-640.webp 640w" sizes="210px" alt="TANAW application preview" width="320" height="560"/><span class="device-label">TANAW · Explore mobile work ↗</span></a></section><div class="proof"><strong>{content.site.proofNumber}</strong><p>{content.site.proofText}<br/><a href={'/projects/'+content.site.proofSlug+'/'}>See the project and context ↗</a></p></div><section class="section"><div class="section-head"><div><p class="eyebrow">SELECTED WORK</p><h2>Useful ideas.<br/>Tangible projects.</h2></div><a href="/projects/">All {projects.length} projects ↗</a></div>{projects.filter(p=>p.featured).slice(0,3).map(project=><Card project={project}/>)}</section><section class="section"><p class="eyebrow">WHAT I BRING</p><h2>From a problem<br/>to something people can use.</h2><div class="capabilities"><article><h3>Practical problem solving</h3><p>Turning operational needs into focused workflows, from attendance to record management.</p><a href="/projects/qr-attendance/">Explore an example ↗</a></article><article><h3>Usable experiences</h3><p>Making web and mobile interfaces clear, responsive, and approachable.</p><a href="/projects/tanaw/">Explore mobile work ↗</a></article><article><h3>Clear communication</h3><p>Organizing information around the people who need it, including educational and business websites.</p><a href="/projects/cyberadryx/">Explore educational work ↗</a></article></div></section></Base>