---
import { content } from '../data/content.js';
const {title=content.site.title,description=content.site.description,path='/'}=Astro.props;
import '../styles/site.css';
const canonical=new URL(path,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/hiraya_logo.png"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(content.site.profileImage,Astro.site)}/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Jules Alfonz Pecaoco',url:Astro.site,jobTitle:'Web and Mobile Application Developer',sameAs:[content.site.github,content.site.linkedin]})}/></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/">Jules<span>.</span></a><nav aria-label="Main navigation"><a href="/projects/">Projects /</a><a href="/about/">About</a><a href="/resume/">CV</a><a href="/contact/">Contact ↗</a></nav><button id="theme" aria-label="Toggle dark theme">◐</button></header><main id="main"><slot/></main><footer><div><p class="eyebrow">LET’S MAKE SOMETHING USEFUL</p><a class="footer-title" href="/contact/">Have a problem in mind? ↗</a><p>Bacolod, Philippines · Open to a conversation</p></div><div class="footer-links"><a href={"mailto:"+content.site.email}>Email</a><a href={content.site.linkedin}>LinkedIn</a><a href={content.site.github}>GitHub</a><a href="/resume/">Download CV</a></div><details><summary>A little of what I listen to ♫</summary><iframe title="Jules’s music — Ben&Ben" loading="lazy" src="https://open.spotify.com/embed/album/7xCcuTA3abKwxj8HwgxP7R" width="100%" height="152" allow="encrypted-media"></iframe></details><div class="footer-bottom"><span>Sic Parvis Magna</span><span>© {new Date().getFullYear()} Jules Alfonz Pecaoco</span><a href="/events/">Notes & events</a></div></footer><script>const button=document.querySelector('#theme');if(localStorage.getItem('theme')==='dark')document.documentElement.classList.add('dark');button?.addEventListener('click',()=>{document.documentElement.classList.toggle('dark');localStorage.setItem('theme',document.documentElement.classList.contains('dark')?'dark':'light')});</script></body></html>