---
import { content, projects } from '../data/content.js';
import { pageSeo, entityGraph } from '../data/seo.js';
import '../styles/site.css';
const { path='/', noindex=false }=Astro.props;
const fallback={title:Astro.props.title || content.site.title,description:Astro.props.description || content.site.description};
const {title,description}=noindex ? fallback : pageSeo(path,fallback);
const canonical=new URL(path,Astro.site);
const root=new URL('/',Astro.site).href;
const ogImage=new URL('/images/og/portfolio.jpg',Astro.site).href;
const imageAlt='Jules Pecaoco — Web and mobile developer in Bacolod, Philippines';
const structuredData=JSON.stringify(entityGraph({content,projects,path,canonical:canonical.href,title,description,root})).replace(/</g,'\u003c');
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<title>{title}</title><meta name="description" content={description}/>
{noindex ? <meta name="robots" content="noindex,follow"/> : <link rel="canonical" href={canonical.href}/>}
<link rel="icon" href="/hiraya_logo.png"/><link rel="describedby" href="/llms.txt"/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Jules Pecaoco"/>
<meta property="og:locale" content="en_PH"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/>
<meta property="og:url" content={canonical.href}/><meta property="og:image" content={ogImage}/>
<meta property="og:image:type" content="image/jpeg"/>
<meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content={imageAlt}/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={ogImage}/><meta name="twitter:image:alt" content={imageAlt}/>
{!noindex && <script type="application/ld+json" set:html={structuredData}/>}
<script is:inline>try{document.documentElement.classList.toggle("dark",localStorage.getItem("theme")==="dark")}catch{}</script></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/">Jules<span>.</span></a><nav aria-label="Main navigation"><a href="/projects/">Projects /</a><a href="/about/">About</a><a href="/resume/">CV</a><a href="/contact/">Contact ↗</a></nav><button id="theme" aria-label="Toggle dark theme">◐</button></header><main id="main"><slot/></main><footer><div><p class="eyebrow">LET’S MAKE SOMETHING USEFUL</p><a class="footer-title" href="/contact/">Have a problem in mind? ↗</a><p>Bacolod, Philippines · Open to a conversation</p></div><div class="footer-links"><a href={"mailto:"+content.site.email}>Email</a><a href={content.site.linkedin}>LinkedIn</a><a href={content.site.github}>GitHub</a><a href={content.resume.url} download>Download CV</a></div><details><summary>A little of what I listen to ♫</summary><iframe title="Jules’s music — Ben&Ben" loading="lazy" src="https://open.spotify.com/embed/album/7xCcuTA3abKwxj8HwgxP7R" width="100%" height="152" allow="encrypted-media"></iframe></details><div class="footer-bottom"><span>Sic Parvis Magna</span><span>© {new Date().getFullYear()} Jules Alfonz Pecaoco</span><a href="#main">Back to top ↑</a></div></footer><script>const button=document.querySelector('#theme');try{if(localStorage.getItem('theme')==='dark')document.documentElement.classList.add('dark')}catch{}button?.addEventListener('click',()=>{document.documentElement.classList.toggle('dark');try{localStorage.setItem('theme',document.documentElement.classList.contains('dark')?'dark':'light')}catch{}});</script><script src="../scripts/interactions.js"></script></body></html>